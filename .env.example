# Public Supabase project values. These are safe to expose to the browser;
# database access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Existing server-only contact email settings. Never prefix these with NEXT_PUBLIC_.
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-app-password
EMAIL_TO=your-contact-recipient
